  line-height: 1.3;
}
.history-tool-button:active {
  transform: translateY(1rpx);
  box-shadow: inset 0 2rpx 7rpx #211b1510;
}
.history-tool-icon {
  font-size: 23rpx;
  opacity: 0.75;
}
.history-clear-tool {
  color: #9f745c;
}
.history-toolbar {
  align-items: center;
  padding-top: 6rpx;
}
.history-toolbar > text {
  font-size: 18rpx;
  max-width: 270rpx;
  line-height: 1.7;
}
.power-board-heading {
  padding: 9rpx 3rpx 0;
}
.board-kicker {
  font-size: 17rpx;
  letter-spacing: 3rpx;
  opacity: 0.7;
}
.board-title {
  font-size: 45rpx;
  font-weight: 650;
  margin-top: 17rpx;
}
.board-description {
  font-size: 23rpx;
  margin-top: 15rpx;
}
.board-period-tabs {
  display: flex;
  background: #ffffff7a;
