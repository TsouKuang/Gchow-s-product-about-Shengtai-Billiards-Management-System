  right: 10rpx;
  top: 9rpx;
  width: 22rpx;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #497656;
  border-radius: 50%;
  color: white;
  font-size: 14rpx;
}
.booking-custom-duration {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 0 25rpx;
  color: #83917e;
  font-size: 22rpx;
}
.booking-stepper {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.booking-stepper > view {
  min-width: 76rpx;
  text-align: center;
  color: #355c42;
  font-size: 26rpx;
  font-weight: 600;
}
.booking-stepper > view text {
  font-size: 20rpx;
  font-weight: 400;
}
.service-booking-sheet .booking-stepper button {
  width: 46rpx;
  height: 46rpx;
  line-height: 44rpx;
  border: 1rpx solid #dbe5db;
  border-radius: 12rpx;
  margin: 0;
  padding: 0;
  font-size: 25rpx;
  background: #fff;
  color: #507154;
}
.booking-stepper button::after {
  border: 0;
}
.booking-stepper button[disabled] {
  opacity: 0.4;
}
.booking-checkout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #dfe7dc;
}
.booking-total {
  font-size: 43rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  color: #285c3e;
  white-space: nowrap;
}
.booking-total view {
  font-size: 19rpx;
  letter-spacing: 0;
  font-weight: 400;
  color: #8f9c87;
  margin-bottom: 8rpx;
}
.booking-total > text {
  font-size: 26rpx;
  margin-right: 4rpx;
}
.service-booking-sheet button.booking-confirm {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45rpx;
  border-radius: 17rpx;
  padding: 25rpx 31rpx;
  margin: 0;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx #2b59321c;
}
.booking-confirm text {
  font-size: 31rpx;
  font-weight: 400;
}
.booking-confirm::after {
  border: 0;
}
.booking-error {
  font-size: 22rpx;
  color: #ad5d43;
  background: #f9eee8;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
@keyframes booking-arrive {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.screen .coach-filter-on,
.screen .selected-brand,
.screen .grade-filter-on {
  background: var(--theme-accent);
  border-color: var(--theme-accent);
  color: white;
}
.screen .service-banner {
  color: var(--theme-accent);
}
.screen .session-service-list {
  background: var(--theme-paper);
  color: var(--theme-accent);
}
.screen .bill-service-amount,
.screen .bill-paid-line,
.screen .settled-note,
.screen .session-order-link,
.screen .order-status.IN_USE,
.screen .service-record-entry,
.screen .detail-personality,
.screen .bill-state,
.screen .profile-id {
  color: var(--theme-accent);
}
.screen .profile-id {
  background: var(--theme-paper);
}
.screen .bill-grand-total {
  border-top: 1rpx solid #e7e3dd;
  margin-top: 22rpx;
  padding-top: 25rpx;
  color: var(--theme-accent);
  font-size: 29rpx;
  font-weight: 650;
}
.session-order-total {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: var(--theme-accent);
}
.session-order-total text {
  font-weight: 650;
}
.service-booking-sheet {
  background: var(--theme-paper);
}
.service-booking-sheet .booking-item-card,
.service-booking-sheet .booking-table-chip.is-selected,
.service-booking-sheet .booking-duration-option.is-selected {
  background: var(--theme-paper);
  border-color: var(--theme-accent);
}
.service-booking-sheet .booking-item-name,
.service-booking-sheet .booking-unit-price,
.service-booking-sheet .booking-hours,
.service-booking-sheet .booking-total,
.service-booking-sheet .booking-title,
.service-booking-sheet .booking-section-heading,
.service-booking-sheet .booking-stepper > view {
  color: var(--theme-accent);
}
.service-booking-sheet button.booking-confirm,
.service-booking-sheet .booking-option-check {
  background: var(--theme-accent);
  color: white;
}
.service-booking-sheet .booking-table-dot {
  background: var(--theme-accent);
}
.wallet-hero {
  padding: 36rpx;
  border-radius: 30rpx;
  background: linear-gradient(130deg, var(--theme-top), var(--theme-mid));
  color: var(--skin-ink);
  box-shadow: 0 15rpx 40rpx #28221918;
  margin: 26rpx 0;
}
.wallet-eyebrow {
  font-size: 17rpx;
  letter-spacing: 4rpx;
  opacity: 0.65;
}
.wallet-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  font-size: 35rpx;
  font-weight: 600;
}
.wallet-id {
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.7;
  letter-spacing: 1rpx;
}
.wallet-balance-label {
  font-size: 21rpx;
  opacity: 0.65;
  margin-top: 42rpx;
}
.wallet-balance {
  font-size: 72rpx;
  font-weight: 650;
  letter-spacing: -2rpx;
  margin: 8rpx 0 24rpx;
}
.wallet-hero-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #ffffff25;
  padding-top: 22rpx;
  font-size: 19rpx;
}
.screen .wallet-hero-footer button {
  width: auto;
  margin: 0;
  padding: 9rpx 24rpx;
  font-size: 22rpx;
  border: 1rpx solid #ffffff40;
  background: #ffffff20 !important;
  color: inherit !important;
  border-radius: 30rpx;
  line-height: 1.7;
}
.wallet-security {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 23rpx;
  padding: 28rpx;
  font-size: 26rpx;
}
.wallet-security text {
  font-size: 20rpx;
  color: #8e8c89;
  display: block;
  margin-top: 9rpx;
}
.screen .wallet-security button {
  background: transparent !important;
  color: var(--theme-accent) !important;
  width: auto;
  font-size: 22rpx;
  padding: 10rpx 0;
  margin: 0;
}
.wallet-record-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 35rpx 4rpx 20rpx;
  font-size: 27rpx;
  font-weight: 600;
}
.wallet-record-heading text:last-child {
  font-size: 19rpx;
  color: #99948b;
  font-weight: 400;
}
.wallet-records {
  background: white;
  border-radius: 26rpx;
  padding: 0 28rpx;
}
.wallet-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 27rpx 0;
  border-bottom: 1rpx solid #f0eeeb;
  gap: 20rpx;
  font-size: 23rpx;
}
.wallet-record:last-child {
  border-bottom: 0;
}
.wallet-record > view {
  min-width: 0;
}
.wallet-record > view > view {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}
.wallet-record > view > text {
  font-size: 18rpx;
  color: #99948b;
  display: block;
  margin-top: 10rpx;
}
.wallet-record-amount {
  font-size: 28rpx;
  white-space: nowrap;
  font-weight: 600;
}
.wallet-record-amount.is-income {
  color: var(--theme-accent);
}
.wallet-empty {
  font-size: 23rpx;
  color: #9d978c;
  text-align: center;
  padding: 45rpx 10rpx;
}
.wallet-reset {
  margin-top: 15rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  font-size: 23rpx;
}
.wallet-reset input {
  margin: 20rpx 0;
  padding: 20rpx;
  background: var(--theme-paper);
  border-radius: 14rpx;
}
.wallet-error,
.wallet-lock-notice {
  font-size: 22rpx;
  color: #a04d37;
  background: #fbefe8;
  border-radius: 15rpx;
  padding: 18rpx 20rpx;
  margin-top: 18rpx;
  line-height: 1.6;
}
.wallet-overlay,
.wallet-pin-overlay {
  position: fixed;
  inset: 0;
  z-index: 6400;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.wallet-pin-overlay {
  z-index: 6600;
}
.wallet-backdrop {
  position: absolute;
  inset: 0;
  background: #1517118c;
  backdrop-filter: blur(8rpx);
}
.wallet-checkout-sheet,
.wallet-pin-sheet {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 750rpx;
  background: var(--theme-paper);
  border-radius: 34rpx 34rpx 0 0;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 94vh;
  overflow-y: auto;
}
.wallet-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 600;
}
.wallet-sheet-heading button {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  background: transparent;
  color: var(--theme-accent);
  font-size: 36rpx;
  margin: 0;
  padding: 0;
}
.wallet-sheet-heading button::after {
  border: 0;
}
.wallet-checkout-title {
  text-align: center;
  font-size: 24rpx;
  color: #8e887e;
  margin: 26rpx 0 12rpx;
}
.wallet-checkout-amount {
  text-align: center;
  font-size: 62rpx;
  font-weight: 650;
  color: var(--theme-accent);
  margin: 10rpx 0 30rpx;
  letter-spacing: -1rpx;
}
.wallet-choice {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 23rpx;
  margin-top: 14rpx;
  background: white;
  border: 1rpx solid #e6e0d6;
  border-radius: 20rpx;
  font-size: 26rpx;
}
.wallet-choice.is-picked {
  border-color: var(--theme-accent);
  box-shadow: inset 0 0 0 1rpx var(--theme-accent);
}
.wallet-choice > view:nth-child(2) {
  flex: 1;
}
.wallet-choice > view > text {
  font-size: 20rpx;
  color: #999184;
  display: block;
  margin-top: 8rpx;
}
.wallet-choice > text {
  color: var(--theme-accent);
}
.wallet-channel-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--theme-paper);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: var(--theme-accent);
  font-size: 27rpx;
  font-weight: 600;
}
.wallet-checkout-sheet button.wallet-primary {
  background: var(--theme-accent);
  color: #fff;
  width: 100%;
  margin: 28rpx 0 0;
  font-size: 28rpx;
  border-radius: 20rpx;
  line-height: 1.5;
  padding: 24rpx 12rpx;
}
.wallet-primary::after {
  border: 0;
}
.wallet-topup-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin: 30rpx 0;
}
.wallet-topup-options > view {
  background: white;
  border: 1rpx solid #dfd8ce;
  border-radius: 17rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
}
.wallet-topup-options .is-picked,
.wallet-topup-channels .is-picked {
  background: var(--theme-accent);
  color: #fff;
  border-color: var(--theme-accent);
}
.wallet-topup-input {
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-bottom: 1rpx solid #d9d2c7;
  padding: 20rpx 4rpx;
  font-size: 35rpx;
}
.wallet-topup-input input {
  flex: 1;
  font-size: 28rpx;
}
.wallet-topup-channels {
  display: flex;
  gap: 18rpx;
  margin: 30rpx 0;
}
.wallet-topup-channels > view {
  flex: 1;
  padding: 21rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #ddd5c7;
  border-radius: 17rpx;
  font-size: 24rpx;
}
.wallet-pin-sheet {
  padding: 27rpx 0 env(safe-area-inset-bottom);
}
.wallet-pin-sheet .wallet-sheet-heading > view {
  width: 50rpx;
}
.wallet-pin-caption {
  text-align: center;
}
.wallet-pin-tip {
  text-align: center;
  color: #9b9488;
}
.wallet-pin-dots {
  display: flex;
  justify-content: center;
}
.wallet-pin-dots > view {
  display: flex;
  align-items: center;
  justify-content: center;
}
.wallet-pin-dot {
  border-radius: 50%;
  animation: pin-dot-pop 0.12s ease-out;
}
.wallet-pin-message {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #af5b41;
}
.wallet-keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.wallet-keypad button {
  margin: 0 !important;
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 0;
  background: #fff;
  color: #27251f;
  font-size: 38rpx;
  line-height: 100rpx;
  padding: 0;
}
.wallet-keypad button::after {
  border: 0;
}
.wallet-keypad button:active {
  background: #ded8ce;
}
.wallet-keypad button[disabled] {
  background: #e8e4dd;
  color: transparent;
}
.wallet-keypad button.delete-key {
  background: #eeeae2;
  color: #645f55;
}
@keyframes pin-dot-pop {
  from {
    transform: scale(0.3);
  }
  to {
    transform: scale(1);
  }
}
.paid-overlay .paid-wait {
  border-color: var(--theme-paper);
  border-top-color: var(--theme-accent);
}

.screen .ongoing,
.screen .active-mini {
  background: linear-gradient(125deg, var(--theme-top), var(--theme-mid));
  color: var(--skin-ink);
}
.screen .service-book {
  background: var(--theme-accent) !important;
}
.screen .record-status-filters .on,
.screen .segment-active {
  color: var(--theme-accent);
}
.wallet-pin-sheet .wallet-sheet-heading button {
  color: var(--theme-accent) !important;
}
.record-status-filters .filter {
  position: relative;
  overflow: visible;
}
.pending-filter-badge {
  position: absolute;
