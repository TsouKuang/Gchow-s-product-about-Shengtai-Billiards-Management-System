  right: 12rpx;
  min-width: 25rpx;
  height: 25rpx;
  line-height: 25rpx;
  box-sizing: border-box;
  padding: 0 7rpx;
  background: #bc6746;
  border: 3rpx solid var(--theme-paper);
  border-radius: 30rpx;
  color: white;
  font-size: 16rpx;
  font-weight: 650;
  box-shadow: 0 3rpx 7rpx #7c2e2020;
  transform: translate(45%, -25%);
}
.profile-back-button {
  width: 67rpx;
  height: 67rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 4rpx 0 24rpx;
  border: 1rpx solid #ffffffb3;
  border-radius: 50%;
  background: linear-gradient(140deg, #fffffff5, var(--theme-paper));
  color: var(--theme-accent);
  box-shadow:
    inset 0 1rpx 0 white,
