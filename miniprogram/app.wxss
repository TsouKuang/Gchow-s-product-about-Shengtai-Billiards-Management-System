@import 'pages/home/wallet.wxss';
view,
text,
button {
  box-sizing: border-box;
}
button {
  border: 0;
  font-size: 27rpx;
  line-height: 1.5;
  padding: 25rpx 24rpx;
  margin: 24rpx 0;
}
button::after {
  border: 0;
}
.hero {
  color: #eff5d9;
  overflow: hidden;
  margin: 16rpx 0 24rpx;
}
.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.quick-scan {
  display: flex;
  align-items: center;
}
.quick-copy {
  flex: 1;
}
.quick-copy > text {
  display: block;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter {
  margin-right: 12rpx;
}
.table-grid {
  flex-wrap: wrap;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ball {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  top: 45rpx;
  left: 45rpx;
}
.gold {
  background: #ddbb60;
  left: 110rpx;
  top: 32rpx;
}
.black {
  background: #25382b;
  left: 117rpx;
  top: 43rpx;
}
.table-bottom {
  display: flex;
  justify-content: space-between;
}
.footnote {
  text-align: center;
}
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid #e6eadd;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 20;
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.back {
  margin: 24rpx 0 32rpx;
}
.section-eyebrow {
  margin-top: 30rpx;
}
.page-title {
  line-height: 1.5;
  margin: 20rpx 0 30rpx;
}
.selected-table {
  justify-content: space-between;
  align-items: center;
}
.package {
  margin: 18rpx 0;
}
.radio {
  border: 2rpx solid #c5d1b7;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 23rpx;
}
.package-copy {
  flex: 1;
  padding-left: 20rpx;
}
.package-name {
  margin-bottom: 8rpx;
}
.currency {
  font-size: 23rpx;
  margin-right: 4rpx;
}
.paybar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.active-mini {
  padding: 26rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
}
.live-dot {
  color: #82a951;
}
.mini-timer {
  font-size: 40rpx;
  margin: 16rpx 0 8rpx;
}
.ongoing {
  padding: 30rpx;
  color: #e4edce;
  margin-bottom: 30rpx;
}
.ongoing > .row {
  font-size: 20rpx;
}
.ongoing-label {
  color: #c0d490;
}
.big-timer {
  text-align: center;
  margin: 38rpx 0 12rpx;
}
.remaining {
  text-align: center;
  font-size: 23rpx;
}
.progress {
  height: 8rpx;
  background: #ffffff16;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 30rpx 0 23rpx;
}
.ongoing-bottom {
  font-size: 20rpx;
  color: #b4c69d;
}
.order-card {
  padding: 28rpx;
  margin: 20rpx 0;
}
.order-table {
  font-weight: 700;
  font-size: 30rpx;
}
.order-table text {
  font-size: 23rpx;
  font-weight: 400;
  margin-left: 10rpx;
}
.order-status {
  font-size: 22rpx;
  color: #8f9c85;
}
.order-date {
  font-size: 22rpx;
  margin-top: 20rpx;
}
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f2eb;
  margin-top: 24rpx;
  padding-top: 22rpx;
}
.empty {
  text-align: center;
  font-size: 23rpx;
  color: #9ba68f;
  padding: 60rpx 25rpx;
  line-height: 1.9;
}
.empty-mark {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 48rpx;
  line-height: 100rpx;
  margin: 0 auto 25rpx;
}
.empty-title {
  font-size: 29rpx;
  margin-bottom: 15rpx;
}
.empty button {
  max-width: 330rpx;
  margin: 30rpx auto;
}
.profile-head {
  display: flex;
  align-items: center;
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 43rpx;
  margin-right: 25rpx;
}
.profile-name {
  margin-bottom: 12rpx;
}
.profile-stats {
  display: flex;
  justify-content: space-around;
  padding: 35rpx 12rpx;
  margin-bottom: 30rpx;
  text-align: center;
}
.profile-stats text {
  font-size: 35rpx;
}
.profile-stats view view {
  font-size: 21rpx;
  margin-top: 16rpx;
}
.menu {
  padding: 0 26rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2eb;
}
.menu-item > text:last-child {
  color: #9ca68f;
}
.alert {
  font-size: 24rpx;
  padding: 22rpx;
  margin: 15rpx 0;
  line-height: 1.7;
}
.retry {
  display: block;
  font-weight: 600;
  margin-top: 10rpx;
}
.receipt {
  padding: 38rpx 30rpx;
}
.receipt-line {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3ed;
}
.receipt-line > text:first-child {
  color: #8c9b80;
}
.hero {
  background: linear-gradient(125deg, #142f26, #244738);
  border: 1rpx solid #6f7956;
  border-radius: 5rpx;
  position: relative;
  padding: 42rpx 38rpx 30rpx;
  box-shadow:
    inset 0 0 0 9rpx #18382d,
    inset 0 0 0 10rpx #8e8d5b;
  margin-top: 25rpx;
}
.hero-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-weight: 400;
  letter-spacing: 5rpx;
  font-size: 49rpx;
  line-height: 1.65;
  margin: 25rpx 0 12rpx;
  color: #efe4c9;
}
.filter.on {
  border-color: #234636;
}
.table-bottom {
  border-top: 1rpx solid #e4d9c1;
}
.bottom-nav {
  background: #f8f1e2;
  border-color: #c9b78f;
}
.package {
  border-color: #d7c7a4;
}
.outline {
  border-color: #beaa82;
}
.profile-head {
  margin-top: 45rpx;
}
.hero.editorial {
  overflow: hidden;
  margin-top: 12rpx;
}
.quick-scan {
  border-color: #e1d8c6;
}
.filters {
  justify-content: space-between;
}
.filter {
  text-align: center;
  background: transparent;
}
.brand-filters {
  display: flex;
  flex-wrap: wrap;
}
.brand-chip {
  margin: 0 12rpx 10rpx 0;
}
.selected-brand {
  border-color: #8b936d;
}
.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.availability {
  display: flex;
  align-items: center;
}
.toggle-dot {
  margin-right: 12rpx;
  position: relative;
}
.toggle-dot::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 50%;
}
.table-card {
  border-color: #e2dacb;
}
.product-photo {
  display: block;
}
.photo-pending {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-pending text:nth-child(2) {
  font-size: 23rpx;
  margin-top: 12rpx;
}
.photo-pending .pending-note {
  font-size: 18rpx;
  margin-top: 20rpx;
  color: #a2876d;
  font-family: sans-serif;
}
.section-title {
  margin-top: 32rpx;
}
.dock {
  border-top: 1rpx solid #e3ddcf;
  padding-top: 20rpx;
}
.nav-item {
  position: relative;
  justify-content: center;
}
.nav-indicator {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  width: 24rpx;
  height: 4rpx;
  background: #436044;
  border-radius: 4rpx;
  transform: translateX(-50%);
}
.nav-active .nav-indicator {
  display: block;
}
.nav-drawing {
  height: 32rpx;
  width: 34rpx;
  position: relative;
  color: inherit;
}
.table-drawing {
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  height: 23rpx;
  margin-top: 8rpx;
  margin-bottom: 11rpx;
}
.table-drawing::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  top: 6rpx;
  left: 11rpx;
}
.order-drawing {
  border: 2rpx solid currentColor;
  width: 26rpx;
  border-radius: 3rpx;
}
.order-drawing::after {
  content: '';
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  top: 8rpx;
  border-top: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  height: 8rpx;
}
.profile-drawing::before {
  content: '';
  position: absolute;
  width: 13rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  top: 0;
  left: 8rpx;
}
.profile-drawing::after {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 15rpx 15rpx 0 0;
  bottom: 0;
  left: 2rpx;
}
.nav-count {
  position: absolute;
  min-width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  border-radius: 15rpx;
  text-align: center;
}
page {
  background: #f2f2f7;
  color: #1c1c1e;
  font-family:
    -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei',
    sans-serif;
  font-size: 28rpx;
}
.screen {
  padding-bottom: 190rpx;
}
.content {
  padding: 0 28rpx;
}
.hero.editorial {
  border: 0;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 35rpx #163f2910;
  background: linear-gradient(130deg, #193c2c, #376b4c);
  padding: 35rpx 34rpx 30rpx;
  margin: 18rpx 0 22rpx;
  min-height: 270rpx;
}
.hero-eyebrow {
  font-family: inherit;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
  color: #b2c9b5;
}
.hero.editorial .hero-title {
  font-family: inherit;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
  margin: 22rpx 0;
  color: #fff;
}
.hero-bottom {
  font-size: 20rpx;
  letter-spacing: 0;
  color: #c7d7c9;
}
.hero-emblem {
  position: absolute;
  right: 32rpx;
  top: 56rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #ffffff09;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 20rpx #ffffff03;
}
.emblem-ball {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 98rpx;
  height: 98rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 25%, #535d4e, #18261c 70%);
  box-shadow: 0 18rpx 25rpx #0b211c35;
  color: #f0f3e9;
  font-family: Georgia, serif;
  font-size: 50rpx;
  border: 1rpx solid #ffffff22;
}
.quick-scan {
  background: #fff;
  border: 0;
  border-radius: 26rpx;
  padding: 25rpx 28rpx;
  box-shadow: 0 3rpx 10rpx #00000003;
}
.scan-icon {
  font-size: 54rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #327753;
  background: #eaf4ed;
  border-radius: 18rpx;
}
.quick-copy {
  padding-left: 21rpx;
}
.quick-copy > view {
  font-family: inherit;
  font-size: 29rpx;
  font-weight: 650;
  letter-spacing: 0;
  color: #1c1c1e;
}
.quick-copy > text {
  color: #8e8e93;
  font-size: 20rpx;
  margin-top: 8rpx;
}
.arrow {
  font-size: 32rpx;
  color: #a6aaa7;
}
.section-title {
  font-size: 33rpx;
  margin: 36rpx 4rpx 23rpx;
}
.section-note {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 400;
}
.filters {
  background: #e4e5eb;
  border-radius: 19rpx;
  padding: 6rpx;
  margin: 15rpx 0 24rpx;
  display: flex;
  gap: 0;
}
.filter {
  border: 0;
  flex: 1;
  border-radius: 14rpx;
  padding: 14rpx 0;
  margin: 0;
  font-size: 23rpx;
  color: #636366;
  font-weight: 500;
  transition:
    background 0.2s,
    box-shadow 0.2s;
}
.filter.on {
  background: #fff;
  color: #1c1c1e;
  box-shadow: 0 3rpx 8rpx #00000015;
  font-weight: 650;
}
.brand-filters {
  margin: 0 2rpx 16rpx;
}
.brand-chip {
  border: 0;
  border-radius: 28rpx;
  background: #e9eaee;
  color: #8e8e93;
  font-size: 21rpx;
  padding: 11rpx 22rpx;
  margin-right: 12rpx;
  transition:
    background 0.2s,
    color 0.2s;
}
.selected-brand {
  background: #dcecdf;
  color: #346c46;
  font-weight: 600;
}
.result-bar {
  font-size: 21rpx;
  color: #8e8e93;
  margin: 12rpx 5rpx 24rpx;
}
.availability {
  font-size: 21rpx;
}
.toggle-dot {
  height: 25rpx;
  width: 43rpx;
  background: #d1d1d6;
  border-radius: 20rpx;
}
.toggle-dot::after {
  height: 21rpx;
  width: 21rpx;
  top: 2rpx;
  left: 2rpx;
  box-shadow: 0 1rpx 3rpx #00000020;
}
.enabled .toggle-dot {
  background: #34c759;
}
.enabled .toggle-dot::after {
  left: 20rpx;
}
.table-grid {
  display: flex;
  gap: 0;
  justify-content: space-between;
}
.table-card {
  width: 48.3%;
  background: #fff;
  padding: 23rpx 20rpx 20rpx;
  border-radius: 26rpx;
  margin-bottom: 22rpx;
  transition:
    transform 0.18s,
    opacity 0.18s;
}
.table-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}
.table-number {
  font-family: inherit;
  font-size: 31rpx;
  letter-spacing: -1rpx;
  font-weight: 700;
  color: #1c1c1e;
}
.subtle {
  color: #8e8e93;
  font-size: 21rpx;
  line-height: 1.7;
}
.status-dot {
  font-size: 17rpx;
  color: #34c759;
}
.status-dot.IN_USE {
  color: #ff9f0a;
}
.status-dot.CLEANING {
  color: #a1a1a6;
}
.status-dot.MAINTENANCE {
  color: #a1a1a6;
}
.product-visual {
  height: 200rpx;
  background: radial-gradient(ellipse at 50% 70%, #e6eae466, transparent 72%);
  border-radius: 14rpx;
  overflow: hidden;
  margin: 10rpx -8rpx 18rpx;
  position: relative;
}
.product-photo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  position: relative;
  filter: drop-shadow(0 12rpx 7rpx #18322310);
}
.model-name {
  font-family: inherit;
  font-size: 23rpx;
  letter-spacing: 0;
  font-weight: 600;
  color: #333b35;
  line-height: 1.5;
  min-height: 42rpx;
}
.table-bottom {
  border: 0;
  padding-top: 15rpx;
  font-size: 20rpx;
  color: #8e8e93;
}
.table-link {
  background: #edf6ef;
  color: #3d7a50;
  border-radius: 15rpx;
  padding: 7rpx 12rpx;
  font-size: 19rpx;
}
.photo-pending {
  background: #f2f3f5;
  color: #8e8e93;
  font-family: inherit;
  font-size: 28rpx;
  border-radius: 18rpx;
}
.dock {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  width: auto;
  padding: 14rpx 10rpx 13rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ffffffcc;
  background: #ffffffe8;
  backdrop-filter: blur(28px) saturate(160%);
  -webkit-backdrop-filter: blur(28px) saturate(160%);
  box-shadow:
    0 10rpx 40rpx #202e3312,
    0 1rpx 3rpx #ffffff;
  display: flex;
  justify-content: space-around;
}
.nav-item {
  width: 23%;
  min-height: 85rpx;
  gap: 8rpx;
  border-radius: 28rpx;
  color: #8e8e93;
  font-size: 19rpx;
  padding: 7rpx 0;
  transition:
    background 0.22s,
    color 0.22s,
    transform 0.15s;
}
.nav-active {
  background: #e5f0e7;
  color: #2e7248;
  font-weight: 650;
}
.nav-item:active {
  transform: scale(0.93);
  background: #e5ece6;
}
.nav-indicator {
  display: none !important;
}
.nav-drawing {
  transform: scale(0.92);
  margin-bottom: 3rpx;
}
.nav-count {
  right: 23rpx;
  top: 0;
  background: #ff453a;
  color: #fff;
  font-family: inherit;
  font-size: 17rpx;
}
.page-title,
.package-name,
.profile-name,
.section-title {
  font-family: inherit;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.page-title {
  font-size: 40rpx;
}
.section-eyebrow {
  font-size: 19rpx;
