  padding: 48rpx 34rpx 30rpx;
  box-sizing: border-box;
  border-radius: 52rpx;
  background: #111614;
  color: #fff;
  text-align: center;
}
.paid-mark {
  width: 132rpx;
  height: 132rpx;
  position: relative;
  margin: 0 auto 28rpx;
}
.paid-ring {
  position: absolute;
  inset: 0;
  border: 6rpx solid #a5ef98;
  border-radius: 50%;
  animation: paid-ring 0.7s ease-out both;
}
.paid-check {
  position: absolute;
  left: 50rpx;
  top: 34rpx;
  width: 28rpx;
  height: 50rpx;
  border: solid #a5ef98;
  border-width: 0 7rpx 7rpx 0;
  transform: rotate(45deg);
  animation: paid-appear 0.25s 0.55s both;
}
.paid-label {
  font-size: 31rpx;
  font-weight: 650;
}
.paid-amount {
  font-size: 58rpx;
  font-weight: 750;
  margin: 6rpx 0 24rpx;
}
.paid-card button {
  background: #a5ef98;
  color: #132318;
  margin: 0;
}
@keyframes paid-ring {
  0% {
    transform: rotateY(100deg) scale(0.65);
    opacity: 0;
  }
  65% {
    transform: rotateY(-20deg) scale(1.08);
    opacity: 1;
  }
  100% {
    transform: rotateY(0) scale(1);
  }
}
@keyframes paid-appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.paid-wait {
  box-sizing: border-box;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 28rpx;
  border: 6rpx solid #38523d;
  border-top-color: #a5ef98;
  border-radius: 50%;
  animation: paid-spin 0.8s linear infinite;
}
@keyframes paid-spin {
  to {
    transform: rotate(360deg);
  }
}
