}
.profile-back-button:active {
  transform: scale(0.94);
  box-shadow: inset 0 2rpx 7rpx #211b1515;
}
.profile-menu-refined {
  padding: 7rpx 25rpx !important;
}
.profile-menu-refined .menu-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 22rpx;
  min-height: 109rpx;
  padding: 12rpx 0;
  font-size: 27rpx;
}
.menu-symbol {
  width: 55rpx;
  height: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #fff, var(--theme-paper));
  border: 1rpx solid #e8e4db;
  border-radius: 17rpx;
  color: var(--theme-accent);
  font-size: 29rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 5rpx #211b1505;
}
.profile-menu-refined .menu-trailing {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--theme-accent);
  opacity: 0.7;
  white-space: nowrap;
}
.menu-subtitle {
  margin-top: 7rpx;
  font-size: 19rpx;
  color: #9d9688;
}
.history-management-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.history-tool-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 13rpx 18rpx;
  background: linear-gradient(135deg, #fffffffa, var(--theme-paper));
  border: 1rpx solid #ffffffb3;
  border-radius: 17rpx;
  color: var(--theme-accent);
  box-shadow:
