.champion-id {
  font-size: 18rpx;
  opacity: 0.55;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}
.champion-number {
  margin-left: auto;
  font-size: 75rpx;
  font-weight: 300;
  font-style: italic;
  opacity: 0.18;
