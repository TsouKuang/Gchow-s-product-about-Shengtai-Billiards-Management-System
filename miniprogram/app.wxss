.champion-duration > text {
  font-size: 20rpx;
  opacity: 0.6;
}
.champion-duration > view {
  font-size: 32rpx;
  font-weight: 600;
}
.board-list {
  background: #ffffffec;
  border: 1rpx solid #fff;
  border-radius: 27rpx;
  padding: 4rpx 25rpx;
}
.board-list-heading {
  display: flex;
  justify-content: space-between;
  padding: 25rpx 0;
  font-size: 19rpx;
  color: #a09787;
  border-bottom: 1rpx solid #efebe4;
}
.board-player {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0ece5;
}
.board-player:last-child {
  border: 0;
}
.board-rank {
  width: 33rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0a592;
  font-weight: 500;
  flex-shrink: 0;
}
.board-rank.rank-1,
.board-rank.rank-2,
.board-rank.rank-3 {
  color: var(--theme-accent);
  font-weight: 700;
}
.board-avatar {
  height: 57rpx;
  width: 57rpx;
  background: var(--theme-paper);
  color: var(--theme-accent);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.board-player-info {
  flex: 1;
  min-width: 0;
}
.board-player-info > view {
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.board-player-info > view > text {
  font-size: 15rpx;
  border: 1rpx solid var(--theme-accent);
  color: var(--theme-accent);
  padding: 1rpx 5rpx;
  border-radius: 5rpx;
  margin-left: 9rpx;
  font-weight: 400;
}
.board-player-info > text {
  display: block;
  font-size: 17rpx;
  color: #a79c89;
  margin-top: 8rpx;
}
.board-player-time {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--theme-accent);
  white-space: nowrap;
}
.board-player-me {
  background: linear-gradient(90deg, transparent, var(--theme-paper), transparent);
}
.board-empty {
  padding: 45rpx 15rpx;
  font-size: 23rpx;
  color: #a39986;
  line-height: 1.8;
  text-align: center;
}
.board-my-standing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
  background: #fffffff0;
  border: 1rpx solid #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 21rpx #211b1509;
  padding: 23rpx 26rpx;
  color: var(--theme-accent);
}
.board-my-standing > view > text {
  display: block;
  font-size: 18rpx;
  color: #a4977c;
}
.board-my-standing > view > view {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.board-my-standing > view:last-child {
  font-size: 27rpx;
  font-weight: 500;
}
.board-footnote {
  font-size: 18rpx;
  text-align: center;
  color: #a79c87;
  line-height: 1.9;
  margin: 25rpx 0 45rpx;
}
.wallet-pin-overlay .wallet-backdrop {
  background: #1e1b1687;
  backdrop-filter: blur(14rpx);
}
.wallet-pin-sheet {
  border-radius: 38rpx 38rpx 0 0 !important;
  background: linear-gradient(155deg, #fff, var(--theme-paper) 75%);
  padding-top: 23rpx;
  box-shadow: 0 -10rpx 60rpx #1d180d26;
}
.wallet-pin-sheet .wallet-sheet-heading {
  padding: 0 27rpx;
  font-size: 25rpx;
  color: #4c473f;
}
.wallet-pin-sheet .wallet-sheet-heading button {
  border: 1rpx solid #ece6db !important;
  border-radius: 50% !important;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  font-size: 31rpx;
  box-shadow:
    0 3rpx 8rpx #29201508,
    inset 0 1rpx 0 #fff;
  background: linear-gradient(140deg, #fff, var(--theme-paper)) !important;
}
.wallet-pin-caption {
  font-size: 22rpx !important;
  color: #918572;
  margin: 20rpx 20rpx 10rpx !important;
}
.wallet-pin-sheet .wallet-checkout-amount {
  font-size: 59rpx;
  letter-spacing: -1.5rpx;
  margin: 6rpx 0 22rpx;
  color: var(--theme-accent);
  font-weight: 600;
}
.wallet-pin-tip {
  font-size: 19rpx;
  margin: 20rpx 0 28rpx;
}
.wallet-pin-dots {
  margin: 22rpx 38rpx 0;
  gap: 13rpx;
}
.wallet-pin-dots > view {
  width: 76rpx;
  height: 77rpx;
  border: 1rpx solid #d9d1c1;
  border-radius: 15rpx;
  background: linear-gradient(160deg, #f0ede6, #fff);
  box-shadow:
    inset 0 2rpx 5rpx #4e3a1510,
    0 1rpx 0 #fff;
  transition:
    border-color 0.15s,
    box-shadow 0.15s;
}
.wallet-pin-dots > view.pin-slot-filled {
  border-color: var(--theme-accent);
  box-shadow:
    inset 0 1rpx 4rpx #5d482010,
    0 0 0 2rpx #bba66e0a;
}
.wallet-pin-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--theme-accent);
}
.wallet-pin-message {
  height: 39rpx;
  padding: 7rpx 20rpx;
  font-size: 18rpx;
}
.wallet-keypad {
  padding: 14rpx 22rpx 18rpx;
  gap: 12rpx;
  background: linear-gradient(180deg, #e8e3d9b0, #eee9df);
  border-top: 1rpx solid #ddd4c2;
  box-sizing: border-box;
}
.wallet-pin-sheet .wallet-keypad button {
  height: 79rpx;
  line-height: 79rpx;
  font-size: 35rpx;
  border-radius: 16rpx !important;
  background: linear-gradient(150deg, #fff, #faf9f6) !important;
  color: #474136 !important;
  box-shadow:
    0 3rpx 0 #d1c8b8,
    0 5rpx 9rpx #33270f07,
    inset 0 1rpx 0 #fff;
  border: 1rpx solid #e8e1d5 !important;
  font-weight: 450;
}
.wallet-pin-sheet .wallet-keypad button:active {
  transform: translateY(3rpx);
  box-shadow: inset 0 2rpx 5rpx #33270f15;
  background: var(--theme-paper) !important;
}
.wallet-pin-sheet .wallet-keypad button[disabled] {
  background: transparent !important;
  box-shadow: none;
  border-color: transparent !important;
  color: transparent !important;
}
.wallet-pin-sheet .wallet-keypad button.delete-key {
  background: #e5dfd4 !important;
  color: var(--theme-accent) !important;
  box-shadow:
    inset 0 1rpx 0 #fff9,
    0 2rpx 0 #d2c8b5;
}

.cue-description {
  white-space: pre-wrap;
  line-height: 1.9;
  margin-bottom: 20rpx;
  color: var(--text);
}
.screen .service-subtitle {
  font-size: 24rpx;
  margin: -4rpx 0 34rpx;
  border: 0;
  background: transparent;
}
.screen .service-banner {
  border: 0;
  background: transparent;
  padding: 12rpx 0 22rpx;
  border-bottom: 1rpx solid #8888881a;
  border-radius: 0;
}
.service-detail-hero {
  position: relative;
}
.cue-image-caption {
  position: absolute;
  bottom: 16rpx;
  right: 18rpx;
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  padding: 9rpx 13rpx;
  background: #ffffffbd;
  border-radius: 10rpx;
  max-width: 85%;
  color: #72716c;
  font-size: 17rpx;
  line-height: 1.6;
  pointer-events: none;
}
.auth-composition {
  padding: 24rpx 3rpx 20rpx;
}
.auth-brand-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--theme-accent);
  margin: 10rpx 0 50rpx;
}
.auth-brand-line > text {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.65;
}
.auth-brand-line > view {
  height: 56rpx;
  width: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #88888840;
  font-size: 28rpx;
  font-weight: 600;
}
.auth-welcome {
  font-size: 49rpx;
  line-height: 1.4;
  letter-spacing: -2rpx;
  font-weight: 650;
  margin-bottom: 14rpx;
}
.auth-tagline {
  font-size: 24rpx;
  color: var(--theme-accent);
  opacity: 0.6;
  margin-bottom: 45rpx;
}
.auth-form-card {
  background: #ffffffd9;
  border: 1rpx solid #ffffffed;
  border-radius: 34rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 50rpx #182d2410;
}
.auth-mode-tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 34rpx;
  border-bottom: 1rpx solid #88888818;
}
.auth-mode-tabs > view {
  padding: 4rpx 0 23rpx;
  color: #9b9b9b;
  font-size: 27rpx;
  position: relative;
}
.auth-mode-tabs .selected {
  font-weight: 600;
  color: var(--theme-accent);
}
.auth-mode-tabs .selected:after {
  content: '';
  height: 5rpx;
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 42rpx;
  border-radius: 10rpx;
  background: var(--theme-accent);
}
.auth-field {
  border: 1rpx solid #88888820;
  border-radius: 20rpx;
  padding: 19rpx 23rpx;
  margin-bottom: 22rpx;
  background: #fafaf9;
}
.auth-field > text {
  font-size: 20rpx;
  color: #999489;
  display: block;
  margin-bottom: 10rpx;
}
.auth-field input {
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  height: 48rpx;
  margin: 0 !important;
  font-size: 28rpx;
}
.screen .auth-submit {
  background: var(--theme-accent) !important;
  color: white !important;
  border-radius: 20rpx !important;
  font-size: 28rpx;
  padding: 0 26rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}
.auth-form-foot {
  font-size: 20rpx;
  color: #a09b90;
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.7;
}
.screen .auth-submit {
  width: 100% !important;
  box-sizing: border-box;
  height: 92rpx !important;
  line-height: 92rpx !important;
  align-items: center;
  font-weight: 600;
}
.screen .auth-submit:after {
  border: 0;
}
.screen {
  background-image: none;
  background-color: var(--theme-paper);
}
.screen .section-eyebrow {
  color: var(--content-muted, #637269);
  opacity: 1;
  letter-spacing: 3rpx;
}
.screen .page-title {
  color: var(--content-ink, #273c33);
}
.service-detail-head .section-eyebrow {
  color: var(--theme-accent);
  opacity: 1;
}
.screen .service-subtitle {
  color: var(--content-muted, #637269);
  opacity: 1;
}
.board-title {
  color: var(--content-ink, #273c33);
}
.board-kicker {
  color: var(--content-ink, #273c33);
}
.board-description {
  color: var(--content-ink, #273c33);
}
button {
  background: linear-gradient(
    180deg,
    var(--theme-mid, var(--theme-accent, #24573f)),
    var(--theme-accent, #24573f)
  );
  box-shadow: 0 10rpx 22rpx rgba(15, 42, 32, 0.16);
}
button:active {
  transform: translateY(1rpx);
  box-shadow: 0 5rpx 12rpx rgba(15, 42, 32, 0.16);
}
button[disabled] {
  background: #dfe6e0;
  color: #8a958c;
  box-shadow: none;
}
.table-card,
.player-profile-editor,
.wallet-records,
.wallet-security,
.rank-summary,
.session-bill,
.bill-service,
.service-record-entry {
  border: 1rpx solid rgba(20, 40, 32, 0.06);
  box-shadow: 0 10rpx 30rpx rgba(15, 42, 32, 0.07);
}
.screen .dock,
.screen .profile-head,
.screen .skin-picker {
  box-shadow:
    inset 0 1rpx 0 #fff,
    0 14rpx 38rpx rgba(20, 32, 38, 0.12);
}
.page-title,
.board-title,
.profile-name,
.section-title {
  letter-spacing: -0.5rpx;
}
.tile-price,
.detail-price,
.wallet-balance,
.payment-amount,
.booking-total,
.rank-summary-amount {
  font-variant-numeric: tabular-nums;
}
.club-prompt-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  box-sizing: border-box;
  background: #0b2019a3;
  backdrop-filter: blur(12px);
}
.club-prompt-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 650rpx;
  max-height: 86vh;
  padding: 36rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #ffffff, var(--theme-paper, #f4f8f5));
  box-shadow: 0 36rpx 100rpx #0003;
  border: 1rpx solid #ffffffa1;
}
.club-prompt-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #e9f0e9;
  border: 1rpx solid #d0dfd4;
  border-radius: 19rpx;
  color: var(--theme-accent, #24573f);
  font-size: 32rpx;
  font-family: Georgia, serif;
}
.club-prompt-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #20372c;
  margin: 24rpx 0 22rpx;
  line-height: 1.5;
}
.club-prompt-scroll {
  max-height: 53vh;
  box-sizing: border-box;
}
.club-prompt-paragraph {
  font-size: 26rpx;
  line-height: 1.9;
  color: #66746c;
  margin: 0 0 16rpx;
  word-break: break-word;
}
.club-prompt-paragraph:first-child {
  color: #344d3e;
}
.club-prompt-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e0e8df;
}
.club-prompt-actions button {
  line-height: 1.4 !important;
  padding: 24rpx 12rpx !important;
  border-radius: 19rpx !important;
  margin: 0 !important;
  font-size: 27rpx !important;
  font-weight: 600;
}
.club-prompt-actions button:after {
  border: 0;
}
.club-prompt-actions .club-prompt-cancel {
  background: #eef1ed !important;
  color: #6a7b6e !important;
}
.club-prompt-actions .club-prompt-confirm {
  background: var(--theme-accent, #24573f) !important;
  color: white !important;
}
.scan-sheet {
  animation: scan-enter 0.28s ease-out;
}
.coach-tile:active,
.wallet-choice:active {
  transform: scale(0.98);
}
@keyframes scan-enter {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.scan-sheet {
  position: relative;
  z-index: 2;
  background: #fffdf7;
  color: #27352d;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 50rpx rgba(25, 31, 25, 0.13);
}
.wallet-choice .scan-channel {
  display: inline-block;
  border: 1rpx solid #c8b998;
  border-radius: 10rpx;
  color: #615338;
  padding: 3rpx 12rpx;
  margin-left: 10rpx;
  font-size: 21rpx;
}
.wallet-glyph {
  position: relative;
  width: 32rpx;
  height: 23rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}
.wallet-glyph:after {
  content: '';
  position: absolute;
  right: -3rpx;
  top: 6rpx;
  width: 10rpx;
  height: 7rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  background: #fff;
}
.wallet-choice > text:last-child {
  margin-left: auto;
  flex: none;
}
.screen .profile-head {
  border: 0;
  background: linear-gradient(120deg, var(--theme-soft, #f4eddf), #fffaf2);
  box-shadow: 0 5rpx 18rpx rgba(38, 40, 34, 0.07);
  border-radius: 30rpx;
}
.screen .profile-head .profile-chevron {
  background: transparent;
  color: var(--theme-accent);
  box-shadow: none;
}
.wallet-choice {
  transition:
    background 0.2s,
    border-color 0.2s,
    transform 0.2s;
}
.wallet-choice:active {
  transform: scale(0.987);
}

.channel-qr-image {
  width: 34rpx;
  height: 34rpx;
}
.screen .profile-head .avatar {
  background: var(--theme-soft, #ede9df);
  color: var(--theme-accent);
}
.payment-spinner {
  width: 76rpx;
  height: 76rpx;
  margin: 42rpx auto;
  border: 5rpx solid #e6e1d5;
  border-top-color: #786235;
  border-radius: 50%;
  animation: payment-turn 1s linear infinite;
}
@keyframes payment-turn {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .payment-spinner {
    animation: none;
  }
}
.scan-expanded {
  display: flex;
  flex-direction: column;
}
.scan-expanded .wallet-checkout-title {
  margin-top: 28rpx;
}
.scan-expanded .payment-spinner {
  margin: auto auto;
  flex: none;
}
.scan-expanded {
  height: 60vh;
  min-height: 60vh;
  max-height: 60vh;
  padding: 34rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #fffdf7;
  color: #27352d;
}
.scan-expanded .wallet-sheet-heading {
  flex: none;
  height: 54rpx;
}
.scan-close-space {
  width: 50rpx;
  height: 50rpx;
}
.scan-stage-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.scan-code-body {
  justify-content: center;
  align-items: center;
}
.scan-merchant {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.scan-merchant-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18rpx;
  border: 1rpx solid #dcd1bd;
  color: var(--theme-accent);
  font:
    500 26rpx Georgia,
    serif;
  background: #f6f1e7;
}
.scan-merchant text {
  display: block;
  font-size: 23rpx;
  font-weight: 400;
  color: #8e887e;
}
.scan-code-frame {
  flex: none;
  position: relative;
  box-sizing: border-box;
  padding: 6rpx;
  background: white;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 36rpx #3831230d;
}
.scan-code-frame image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 18rpx;
}
.qr-focus-corner {
  position: absolute;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid var(--theme-accent);
  pointer-events: none;
  opacity: 0.45;
  transition: opacity 0.2s;
}
.corner-tl {
  left: -14rpx;
  top: -14rpx;
  border-right: 0;
  border-bottom: 0;
  border-radius: 16rpx 0 0 0;
}
.corner-tr {
  right: -14rpx;
  top: -14rpx;
  border-left: 0;
  border-bottom: 0;
  border-radius: 0 16rpx 0 0;
}
.corner-bl {
  left: -14rpx;
  bottom: -14rpx;
  border-right: 0;
  border-top: 0;
  border-radius: 0 0 0 16rpx;
}
.corner-br {
  right: -14rpx;
  bottom: -14rpx;
  border-left: 0;
  border-top: 0;
  border-radius: 0 0 16rpx 0;
}
.is-recognized .qr-focus-corner {
  opacity: 1;
  animation: qr-focus-lock 0.6s cubic-bezier(0.22, 0.7, 0.25, 1) both;
}
.corner-tl {
  --focus-x: 10rpx;
  --focus-y: 10rpx;
}
.corner-tr {
  --focus-x: -10rpx;
  --focus-y: 10rpx;
}
.corner-bl {
  --focus-x: 10rpx;
  --focus-y: -10rpx;
}
.corner-br {
  --focus-x: -10rpx;
  --focus-y: -10rpx;
}
@keyframes qr-focus-lock {
  0% {
    transform: translate(0, 0);
    opacity: 0.45;
  }
  55% {
    transform: translate(var(--focus-x), var(--focus-y));
    opacity: 1;
  }
  100% {
    transform: translate(var(--focus-x), var(--focus-y));
    opacity: 1;
  }
}
.scan-recognition-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #8e887e;
  font-size: 23rpx;
  margin-top: 8rpx;
}
.scan-status-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--theme-accent);
  box-shadow: 0 0 0 6rpx #bda97615;
}
.scan-pin-body,
.scan-processing-body {
  animation: scan-body-rise 0.36s cubic-bezier(0.22, 0.7, 0.25, 1) both;
}
@keyframes scan-body-rise {
  from {
    opacity: 0;
    transform: translateY(52rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.scan-payment-summary {
  flex: none;
  padding: 12rpx 0 4rpx;
}
.scan-expanded .wallet-checkout-title {
  margin: 18rpx 0 10rpx;
}
.scan-expanded .wallet-checkout-amount {
  margin: 8rpx 0 16rpx;
  font-size: 62rpx;
}
.scan-pin-body .wallet-pin-dots {
  flex: none;
  margin: 12rpx 0 0;
  gap: 12rpx;
}
.scan-pin-body .wallet-pin-dots > view {
  width: 72rpx;
  height: 72rpx;
  background: #faf8f1;
  border-color: #e4dccd;
  box-shadow: none;
}
.scan-pin-body .wallet-pin-message {
  flex: none;
  height: 44rpx;
  padding: 10rpx 0;
  font-size: 22rpx;
  color: #28704f;
}
.scan-pin-body .wallet-pin-message.is-error {
  color: #af5b41;
}
.scan-pin-body .wallet-keypad {
  flex: 1;
  min-height: 0;
  max-height: 400rpx;
  width: 100%;
  align-self: center;
  margin-top: auto;
  padding: 10rpx 0 0;
  grid-template-rows: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  background: transparent;
}
.scan-pin-body .wallet-keypad button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 0;
  border-radius: 16rpx;
  line-height: 1;
  font-size: 36rpx;
  border: 1rpx solid #e7e0d4;
  background: #faf8f1;
  box-shadow: none;
}
.scan-pin-body .wallet-keypad button:active {
  background: #e9e2d4;
}
.scan-pin-body .wallet-keypad button[disabled] {
  background: #f4f1e9;
  color: #7d786e;
}
.scan-pin-body .wallet-keypad button[disabled]:nth-child(10) {
  background: transparent;
  border-color: transparent;
  color: transparent;
}
.scan-pin-body .wallet-keypad button.delete-key {
  background: #f1ecdf;
  color: var(--theme-accent);
}
.scan-processing-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: 68rpx;
  color: #8e887e;
  font-size: 24rpx;
}
.scan-expanded .scan-processing-center .payment-spinner {
  flex: none;
  margin: 0;
}
@media (max-height: 650px) {
  .scan-code-body {
    gap: 18rpx;
    padding: 4rpx 0;
  }
  .scan-merchant-seal {
    display: none;
  }
  .scan-pin-body .wallet-pin-dots > view {
    height: 60rpx;
  }
  .scan-expanded .wallet-checkout-amount {
    font-size: 54rpx;
    margin-bottom: 8rpx;
  }
  .scan-pin-body .wallet-pin-message {
    height: 34rpx;
    padding: 6rpx 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .is-recognized .qr-focus-corner,
  .scan-pin-body,
  .scan-processing-body {
    animation: none;
  }
  .is-recognized .qr-focus-corner {
    opacity: 1;
  }
}

.checkout-method-sheet {
  height: 60vh;
  min-height: 60vh;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  background: #fffdf7;
}
.checkout-method-sheet > .wallet-primary {
  margin-top: auto !important;
  flex: none;
}
.checkout-method-sheet .wallet-choice {
  flex: none;
}
.scan-code-body {
  gap: 20rpx;
  padding: 8rpx 0 16rpx;
}
.scan-code-frame {
  width: min(340rpx, 28vh);
  height: min(340rpx, 28vh);
}
.scan-merchant-seal {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
  border-radius: 15rpx;
  font-size: 23rpx;
}
.scan-merchant text {
  margin-top: 8rpx;
}
@media (max-height: 750px) {
  .scan-merchant-seal {
    display: none;
  }
  .scan-code-body {
    gap: 16rpx;
    padding: 4rpx 0;
  }
}
@media (max-height: 650px) {
  .scan-code-frame {
    width: 240rpx;
    height: 240rpx;
  }
  .checkout-method-sheet .wallet-checkout-title {
    margin: 14rpx 0 6rpx;
  }
  .checkout-method-sheet .wallet-checkout-amount {
    font-size: 52rpx;
    margin: 6rpx 0 12rpx;
  }
  .checkout-method-sheet .wallet-choice {
    padding: 15rpx;
    margin-top: 10rpx;
  }
}
.club-prompt-actions button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 84rpx;
}

@import 'pages/home/exclusive-skins.wxss';

.wallet-checkout-sheet,
.wallet-pin-sheet,
.payment-sheet {
  animation: payment-sheet-rise 0.42s cubic-bezier(0.22, 0.75, 0.25, 1) both;
}
.wallet-backdrop,
.payment-backdrop {
  animation: payment-backdrop-in 0.28s ease-out both;
}
.scan-expanded .scan-pin-body {
  animation: payment-content-rise 0.4s cubic-bezier(0.22, 0.75, 0.25, 1) both;
}
.scan-expanded .scan-processing-body {
  animation: payment-content-rise 0.32s cubic-bezier(0.22, 0.75, 0.25, 1) both;
}
@keyframes payment-sheet-rise {
  from {
    transform: translateY(100%);
    opacity: 0.8;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@keyframes payment-content-rise {
  from {
    transform: translateY(65rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@keyframes payment-backdrop-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@media (prefers-reduced-motion: reduce) {
  .wallet-checkout-sheet,
  .wallet-pin-sheet,
  .payment-sheet,
  .wallet-backdrop,
  .payment-backdrop,
  .scan-expanded .scan-pin-body,
  .scan-expanded .scan-processing-body {
    animation: none;
  }
}

@import 'pages/home/appearance.wxss';
