<view
  style="{{themeStyle}}"
  class="app-themed screen theme-{{skinKey}} exclusive-{{exclusiveSkinKey}} {{exclusiveSkinKey!=='none'?'exclusive-active':''}} {{profilePage==='wallet'?'wallet-console':''}} {{profilePage==='skins'?'skin-gallery':''}}"
>
  <view class="content">
    <view class="alert" wx:if="{{error}}">
      <text>{{error}}</text>
      <text class="retry" bindtap="refresh">重试</text>
    </view>
    <block wx:if="{{serviceSelected}}">
      <view class="back" bindtap="back">‹ 返回服务</view>
      <view
        class="service-detail-hero {{serviceSelected.kind==='COACH'?'portrait-hero':'cue-hero'}}"
      >
        <image
          src="{{serviceSelected.imageSrc}}"
          mode="{{serviceSelected.kind==='COACH'?'aspectFill':'aspectFit'}}"
        />
        <view wx:if="{{serviceSelected.kind==='CUE'}}" class="cue-image-caption">
          <text>选定时长 · 支付后确认租赁</text>
          <text>归还交前台验收 · 费用计入本局</text>
        </view>
      </view>
      <view class="service-detail-head">
        <view class="section-eyebrow">{{serviceSelected.kind==='COACH'?'MEET YOUR COACH':serviceSelected.brand}}</view>
        <view class="service-detail-title">{{serviceSelected.name}}</view>
        <view wx:if="{{serviceSelected.kind==='COACH'}}" class="detail-grade"><text>{{serviceSelected.starsText}}</text> {{serviceSelected.grade_title}}</view>
        <view class="detail-price">¥{{serviceSelected.hourlyText}}<text>/ 小时</text></view>
      </view>
      <block wx:if="{{serviceSelected.kind==='COACH'}}">
        <view class="profile-facts">
          <view>
            <text>{{serviceSelected.gender}}</text>
            <view>性别</view>
          </view>
          <view>
            <text>{{serviceSelected.age}}岁</text>
            <view>年龄</view>
          </view>
          <view>
            <text>{{serviceSelected.height_cm}}cm</text>
            <view>身高</view>
          </view>
          <view>
            <text>{{serviceSelected.weight_kg}}kg</text>
            <view>体重</view>
          </view>
        </view>
        <view class="detail-section">
          <view class="detail-section-title">认识一下</view>
          <view class="detail-personality">{{serviceSelected.personality}}</view>
          <view>{{serviceSelected.description}}</view>
        </view>
        <view class="detail-section">
          <view class="detail-section-title">擅长项目</view>
          <view>{{serviceSelected.specialties}}</view>
        </view>
        <view class="demo-people-note">助教资料为示例</view>
      </block>
      <view wx:else class="detail-section">
        <view class="detail-section-title">球杆资料与租赁</view>
        <view class="cue-description">{{serviceSelected.description || "门店暂未填写球杆介绍"}}</view>
      </view>
      <view wx:if="{{serviceSelected.kind==='COACH'}}" class="detail-section">
        <view class="detail-section-title">服务计费</view>
        <view>选定助教后开始计时，费用计入本局账单。</view>
      </view>
      <view class="detail-booking-bar">
        <view>
          <view
            class="availability-badge {{serviceSelected.available>0 ? 'availability-open' : 'availability-busy'}}"
          >{{serviceSelected.kind==='CUE' ? (serviceSelected.available>0 ? '可租 '+serviceSelected.available+' 根' : '暂时租完') : (serviceSelected.available>0 ? '可预约' : '服务中')}}</view>
          <view class="detail-price">¥{{serviceSelected.hourlyText}}<text>/小时</text></view>
        </view>
        <button
          data-id="{{serviceSelected.id}}"
          bindtap="bookService"
          loading="{{busy}}"
          disabled="{{busy||!serviceSelected.enabled||serviceSelected.available<1}}"
        >{{serviceSelected.available>0?(serviceSelected.kind==='CUE'?'申请租赁这支球杆':'选择'+serviceSelected.name):'暂不可预约'}}</button>
      </view>
    </block>
    <block wx:elif="{{selected}}">
      <view class="back" bindtap="back">‹ 返回大厅</view>
      <view class="section-eyebrow">START YOUR GAME</view>
      <view class="page-title">为这一局，选个套餐</view>
      <view class="selected-table">
        <view class="row">
          <view>
            <view class="table-number">{{selected.table_no}}</view>
            <view class="subtle">{{selected.type}} · {{selected.brand}} {{selected.model_name}}</view>
          </view>
          <view class="pill {{selected.status}}">{{labels[selected.status]}}</view>
        </view>
        <view class="selected-photo">
          <image wx:if="{{selected.image_path}}" src="{{selected.imageSrc}}" mode="aspectFit" />
          <view wx:else>{{selected.brand}}</view>
        </view>
      </view>
      <view class="section-title">选择时长<text class="section-note">当前球桌套餐价格</text></view>
      <view
        wx:for="{{packages}}"
        wx:key="id"
        class="package {{packageId===item.id?'chosen':''}}"
        data-id="{{item.id}}"
        bindtap="pack"
      >
        <view class="row">
          <view class="radio">{{packageId===item.id?'✓':''}}</view>
          <view class="package-copy">
            <view class="package-name">{{item.name}}</view>
            <view class="subtle">{{item.minutes}} 分钟 · 开台后开始计时</view>
          </view>
          <view class="price"><text class="currency">¥</text>{{item.price}}</view>
        </view>
      </view>
      <view wx:if="{{!packages.length}}" class="empty">暂无在售套餐，请联系前台。</view>
      <view class="paybar">
        <view>
          <view class="subtle">应付合计</view>
          <view class="price">¥{{chosenPackage?chosenPackage.price:'0.00'}}</view>
        </view>
        <button
          wx:if="{{selected.status==='IDLE'}}"
          bindtap="open"
          loading="{{busy}}"
          disabled="{{busy||!chosenPackage}}"
        >{{isDemo?'支付并开台':'去付款 →'}}</button>
        <button wx:else disabled>球桌暂不可用</button>
      </view>
    </block>
    <block wx:elif="{{detail}}">
      <view class="back" bindtap="back">‹ 返回订单</view>
      <view class="section-eyebrow">YOUR GAME · SERVICES</view>
      <view class="bill-heading">
        <view class="page-title">这一局，明白消费。</view>
        <button
          class="bill-refresh"
          bindtap="refreshBill"
          loading="{{busy}}"
          disabled="{{busy||!detail}}"
        >刷新账单</button>
      </view>
      <view wx:if="{{billLoading && !bill}}" class="empty">正在核对本局账单…</view>
      <block wx:if="{{bill}}">
        <view class="session-bill">
          <view class="row">
            <view class="bill-table-number">{{detail.table_no}}</view>
            <text class="bill-state">{{bill.stateText}}</text>
          </view>
          <view class="bill-package-name">{{detail.package_name}} · {{detail.minutes}} 分钟</view>
          <view class="bill-paid-line">
            <text>{{detail.tablePaidLabel}}</text>
            <text>¥{{bill.tablePaidText}}</text>
          </view>
          <view class="bill-quiet">球桌套餐已支付，结算服务时不会重复收取。</view>
          <view class="receipt-line">
            <text>开始时间</text>
            <text>{{detail.startText}}</text>
          </view>
          <view class="receipt-line">
            <text>{{detail.status==='ACTIVE'?'套餐预计到时':'球桌结束时间'}}</text>
            <text>{{detail.status==='ACTIVE'?detail.endText:detail.finishText}}</text>
          </view>
          <view class="bill-order-no">{{detail.order_no}}</view>
        </view>
        <view class="section-title">本局服务明细<text class="section-note">{{bill.services.length}} 项</text></view>
        <view wx:if="{{!bill.services.length}}" class="bill-empty">本局还没有助教或球杆服务。</view>
        <view wx:for="{{bill.services}}" wx:key="id" class="bill-service">
          <view class="row">
            <view class="bill-service-title">{{item.item_name}}</view>
            <text class="bill-service-state {{item.status}}">{{item.stateText}}</text>
          </view>
          <view class="bill-service-meta">{{item.kind==='COACH'?'助教服务':'球杆租赁'}} · 下单价 ¥{{item.rateText}} / {{item.kind==='COACH'&&!item.booked_hours?'分钟':'小时'}}<text wx:if="{{item.booked_hours}}"> · 已订 {{item.booked_hours}} 小时</text></view>
          <view class="bill-service-meta" wx:if="{{item.started_at}}">开始 {{item.startText}}</view>
          <view class="bill-service-amount" wx:if="{{item.is_estimate}}">当前预估 ¥{{item.estimateText}}<text>最终金额按结束时间计算</text></view>
          <view
            class="bill-service-amount"
            wx:elif="{{item.amount!==null && item.amount!==undefined}}"
          >{{item.status==='SETTLED'?item.paymentText:'待结算'}} ¥{{item.amountText}}<text>实际使用 {{item.billed_minutes}} 分钟</text></view>
          <view class="bill-service-tip" wx:if="{{item.kind==='CUE' && item.status==='ACTIVE'}}">球杆仍在租用，请交回前台验收。结束球桌不会自动停止球杆计时。</view>
          <view class="bill-service-tip" wx:if="{{item.status==='REQUESTED'}}">待前台确认领取，尚未开始计时。</view>
          <view class="record-actions">
            <button
              wx:if="{{item.canFinish}}"
              class="record-button"
              data-id="{{item.id}}"
              bindtap="finishCoach"
              disabled="{{busy}}"
            >结束助教服务</button>
            <button
              wx:if="{{item.status==='REQUESTED'}}"
              class="record-button secondary-record"
              data-id="{{item.id}}"
              bindtap="cancelService"
              disabled="{{busy}}"
            >取消申请</button>
          </view>
        </view>
        <view class="bill-summary">
          <view class="receipt-line">
            <text>开台费用</text>
            <text>¥{{bill.tablePaidText}}</text>
          </view>
          <view class="receipt-line">
            <text>已结束服务合计</text>
            <text>¥{{bill.serviceTotalText}}</text>
          </view>
          <view class="receipt-line" wx:if="{{detail.status==='ACTIVE'}}">
            <text>服务当前预估合计</text>
            <text>¥{{bill.estimateTotalText}}</text>
          </view>
          <view wx:if="{{detail.status==='ACTIVE'}}" class="bill-quiet">进行中的助教费用继续累计，结束本局时一并停止计时。</view>
          <view wx:if="{{bill.pendingCueCount}}" class="return-alert">{{bill.pendingCueCount}} 根球杆待归还 · 归还确认后才能完成本局结算</view>
          <view class="receipt-line bill-grand-total">
            <text>开台＋服务合计</text>
            <text>¥{{bill.totalText}}</text>
          </view>
          <view class="receipt-line">
            <text>本局已付</text>
            <text>¥{{bill.paidText}}</text>
          </view>
          <view wx:if="{{bill.settlementStatus==='SETTLED'}}" class="settled-note">{{bill.stateText}} · 本局无待付费用</view>
        </view>
        <button
          wx:if="{{detail.status==='ACTIVE'}}"
          class="finish-session-button"
          data-id="{{detail.id}}"
          bindtap="finish"
          loading="{{busy}}"
          disabled="{{busy}}"
        >结束本局并生成账单</button>
        <button
          wx:if="{{bill.canPay}}"
          class="settle-session-button"
          data-id="{{detail.id}}"
          bindtap="settle"
          loading="{{busy}}"
          disabled="{{busy}}"
        >{{isDemo?'支付服务费用 ¥'+bill.unpaidText:'去付款'}}</button>
        <button
          wx:if="{{detail.status!=='ACTIVE' && bill.settlementStatus==='SETTLED'}}"
          class="outline hide-detail-button"
          data-id="{{detail.id}}"
          data-kind="PLAY"
          bindtap="hideRecord"
          disabled="{{busy}}"
        >从我的历史中移除</button>
      </block>
    </block>
    <block wx:elif="{{tab==='tables'}}">
      <view class="hero editorial">
        <view class="hero-eyebrow">SHENGTAI BILLIARDS</view>
        <view class="hero-title">来一局，<view>刚刚好。</view></view>
        <view class="hero-bottom">
          <text>中式八球 / 美式九球 / 斯诺克</text>
        </view>
        <view class="hero-emblem">
          <view class="emblem-ball">8</view>
        </view>
      </view>
      <view class="quick-scan" data-tab="services" bindtap="switchTab">
        <view class="scan-icon">
          <view class="scan-symbol"></view>
        </view>
        <view class="quick-copy">
          <view>好杆相伴，好局从容</view>
          <text>球杆租赁与台球助教 · 探索门店服务</text>
        </view>
        <text class="arrow">↗</text>
      </view>
      <view wx:if="{{active}}" class="active-mini" data-id="{{active.id}}" bindtap="showOrder">
        <view class="row">
          <view><text class="live-dot">●</text> {{active.table_no}} 正在使用</view>
          <text>查看本局 ›</text>
        </view>
        <view class="mini-timer">{{active.elapsed}}</view>
        <view class="subtle">{{active.remaining}}</view>
        <view class="active-service-summary">{{active.serviceSummary}}</view>
      </view>
      <view wx:if="{{logged && pendingServiceCount}}" class="home-service-shortcuts">
        <view data-kind="COACH" bindtap="openOrders">助教服务 ›</view>
        <view data-kind="CUE" bindtap="openOrders">球杆租赁 ›</view>
      </view>
      <view class="section-title">挑一张喜欢的球桌<text class="section-note">{{available}} 张空闲</text></view>
      <view class="filters">
        <view
          wx:for="{{['全部','中式八球','美式九球','斯诺克']}}"
          wx:key="*this"
          class="filter {{filter===item?'on':''}}"
          data-value="{{item}}"
          bindtap="setFilter"
        >{{item}}</view>
      </view>
      <view class="brand-filters">
        <view
          wx:for="{{brandOptions}}"
          wx:key="*this"
          class="brand-chip {{brandFilter===item?'selected-brand':''}}"
          data-value="{{item}}"
          bindtap="setBrand"
        >{{item}}</view>
      </view>
      <view class="result-bar">
        <text>共 {{visibleTables.length}} 张球桌</text>
        <view class="availability {{availableOnly?'enabled':''}}" bindtap="toggleAvailable"><text class="toggle-dot"></text>只看空闲</view>
      </view>
      <view wx:if="{{loading && !tables.length}}" class="empty">正在为你查看球桌…</view>
      <view class="table-grid">
        <view
          wx:for="{{visibleTables}}"
          wx:key="id"
          class="table-card"
          data-id="{{item.id}}"
          bindtap="choose"
        >
          <view class="row">
            <text class="table-number">{{item.table_no}}</text>
            <text class="status-dot {{item.status}}">●</text>
          </view>
          <view class="subtle">{{item.type}}</view>
          <view class="product-visual">
            <image
              wx:if="{{item.image_path}}"
              class="product-photo"
              src="{{item.imageSrc}}"
              mode="aspectFit"
            />
            <view wx:else class="photo-pending">
              <text>{{item.brand}}</text>
              <text>{{item.model_name}}</text>
              <text class="pending-note">型号实拍待补</text>
            </view>
          </view>
          <view class="model-name">{{item.brand}} · {{item.model_name}}</view>
          <view class="table-bottom">
            <text>{{labels[item.status]}}</text>
            <text class="table-link">{{item.status==='IDLE'?'选套餐 ›':'查看 ›'}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!loading && !visibleTables.length}}" class="empty">这个分类暂时没有球桌，试试其他分类。</view>
      <view class="footnote">所有桌上二维码为同一小程序入口，进入后在此选桌。</view>
    </block>
    <block wx:elif="{{tab==='services'}}">
      <view class="section-eyebrow">THE CLUB COLLECTION</view>
      <view class="page-title">好局，更进一步。</view>
      <view class="service-subtitle">球杆租赁 · 助教预约</view>
      <view class="service-record-entry" data-kind="{{serviceKind}}" bindtap="openOrders">
        <view>
          <text>服务进度与记录</text>
          <view>在订单中查看、结束和结算服务</view>
        </view>
        <text>查看订单 ›</text>
      </view>
      <view class="service-segments">
        <view
          class="{{serviceKind==='CUE'?'segment-active':''}}"
          data-value="CUE"
          bindtap="setServiceKind"
        >球杆租赁</view>
        <view
          class="{{serviceKind==='COACH'?'segment-active':''}}"
          data-value="COACH"
          bindtap="setServiceKind"
        >台球助教</view>
      </view>
      <view class="service-banner">
        <view>{{serviceKind==='CUE'?'一杆在手，自有分寸。':'按等级选助教，按小时预约。'}}</view>
        <text>{{serviceKind==='CUE'?'前台验杆领取 · 按整小时向上计费':'选定时长后开始服务 · 1小时起订'}}</text>
        <text>服务价格与可用数量以当前门店为准</text>
      </view>
      <view wx:if="{{serviceKind==='CUE'}}" class="service-brand-list">
        <view
          wx:for="{{serviceBrands}}"
          wx:key="*this"
          class="brand-chip {{serviceBrand===item?'selected-brand':''}}"
          data-value="{{item}}"
          bindtap="setServiceBrand"
        >{{item}}</view>
      </view>
      <block wx:if="{{serviceKind==='COACH'}}">
        <view class="coach-filter-row">
          <view
            wx:for="{{['全部','女','男']}}"
            wx:key="*this"
            class="coach-filter {{serviceGender===item?'coach-filter-on':''}}"
            data-value="{{item}}"
            bindtap="setServiceGender"
          >{{item==='全部'?'全部助教':item+'助教'}}</view>
        </view>
        <view class="coach-grade-filters">
          <view
            wx:for="{{[0,3,4,5,6]}}"
            wx:key="*this"
            class="grade-filter {{serviceGrade===item?'grade-filter-on':''}}"
            data-value="{{item}}"
            bindtap="setServiceGrade"
          >{{item===0?'全部等级':item+'星'}}</view>
        </view>
        <view class="demo-people-note">助教示例 · 按球技评定等级</view>
      </block>
      <view class="service-results">{{visibleServices.length}} {{serviceKind==='CUE'?'款精选球杆':'位台球助教'}}<text>点击卡片查看详情</text></view>
      <view wx:if="{{serviceKind==='CUE'}}" class="cue-grid">
        <view
          class="cue-tile"
          wx:for="{{visibleServices}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="showService"
        >
          <view class="cue-picture">
            <image src="{{item.imageSrc}}" mode="aspectFit" lazy-load="true" />
          </view>
          <view class="cue-tile-body">
            <view class="service-brand">{{item.brand}}</view>
            <view class="cue-name">{{item.name}}</view>
            <view class="cue-tile-footer">
              <view>
                <text class="tile-price">¥{{item.rate}}</text>
                <text class="tile-unit">/小时</text>
              </view>
              <text class="tile-arrow">↗</text>
            </view>
            <view
              class="tile-stock availability-badge {{item.available>0 ? 'availability-open' : 'availability-busy'}}"
            >{{item.available>0?'可租 '+item.available+' 根':'暂时租完'}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="coach-grid">
        <view
          class="coach-tile"
          wx:for="{{visibleServices}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="showService"
        >
          <view class="coach-picture">
            <image src="{{item.imageSrc}}" mode="aspectFill" lazy-load="true" />
            <view class="coach-level level-{{item.star_level}}">{{item.grade_title}}</view>
            <view
              class="coach-availability availability-badge {{item.available>0 ? 'availability-open' : 'availability-busy'}}"
            >{{item.available>0?'可预约':'服务中'}}</view>
          </view>
          <view class="coach-tile-body">
            <view class="coach-name-row">
              <text class="coach-name">{{item.name}}</text>
              <text class="coach-gender">{{item.gender}} · {{item.age}}岁</text>
            </view>
            <view class="coach-measurements">{{item.height_cm}}cm / {{item.weight_kg}}kg</view>
            <view class="coach-personality">{{item.personality}}</view>
            <view class="coach-tile-footer">
              <view>
                <text class="tile-price">¥{{item.hourlyText}}</text>
                <text class="tile-unit">/小时</text>
              </view>
              <text class="tile-arrow">↗</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{!visibleServices.length}}" class="empty">暂时没有匹配的服务，试试其他筛选。</view>
      <view class="footnote">系列名称参考品牌资料，不作“最好”排名；实际杆型与配置以门店实物为准。</view>
    </block>
    <block wx:elif="{{tab==='orders'}}">
      <view class="section-eyebrow">MY GAMES · SERVICES</view>
      <view class="page-title">每一局，井然有序。</view>
      <view class="ongoing" wx:if="{{active && orderFilter==='进行中'}}">
        <view class="row">
          <text class="ongoing-label">● 正在进行</text>
          <text>{{active.table_no}} / {{active.package_name}}</text>
        </view>
        <view class="big-timer">{{active.elapsed}}</view>
        <view class="remaining">{{active.remaining}}</view>
        <progress
          class="session-progress"
          percent="{{active.progress}}"
          stroke-width="4"
          activeColor="{{heroAccent}}"
          backgroundColor="{{heroTrack}}"
        />
        <view class="active-service-summary">{{active.serviceSummary}}</view>
        <view class="row ongoing-bottom">
          <text>预计到时 {{active.endText}}</text>
          <text data-id="{{active.id}}" bindtap="showOrder">查看本局 ›</text>
        </view>
      </view>
      <view class="filters record-status-filters">
        <view
          wx:for="{{['进行中','待结算','历史']}}"
          wx:key="*this"
          class="filter {{orderFilter===item?'on':''}}"
          data-value="{{item}}"
          bindtap="setOrderFilter"
        >{{item}}<text wx:if="{{item==='待结算' && pendingOrderCount}}" class="pending-filter-badge">{{pendingOrderCount}}</text></view>
      </view>
      <view wx:if="{{logged && orderFilter==='历史'}}" class="history-toolbar">
        <text>仅显示已结清或已取消记录</text>
        <view class="history-management-actions">
          <view class="history-tool-button" bindtap="toggleManageHistory">
            <text class="history-tool-icon">{{managingHistory?'✓':'☷'}}</text>
            <text>{{managingHistory?'完成':'管理'}}</text>
          </view>
          <view class="history-tool-button history-clear-tool" bindtap="clearHistory">
