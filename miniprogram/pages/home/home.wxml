              <view class="menu-symbol">✧</view>
              <view>
                <text>专属皮肤</text>
                <view class="menu-subtitle">科技 · 复古 · 黄金全解锁</view>
              </view>
              <text class="menu-trailing">›</text>
            </view>
            <view wx:if="{{logged}}" class="menu-item" bindtap="openLeaderboard">
              <view class="menu-symbol">♛</view>
              <view>
                <text>圣泰球力榜</text>
                <view class="menu-subtitle">月度球王 · 年度球王</view>
              </view>
              <text class="menu-trailing">›</text>
            </view>
          </view>
          <button wx:if="{{logged}}" class="outline" bindtap="logout">退出登录</button>
          <view class="footnote">永州圣泰台球俱乐部 · 一席青毡，一局从容</view>
        </block>
      </block>
    </block>
  </view>
  <view
    class="bottom-nav dock"
    wx:if="{{!selected && !detail && !serviceSelected && !profilePage}}"
  >
    <view class="nav-item {{tab==='tables'?'nav-active':''}}" data-tab="tables" bindtap="switchTab">
      <view class="nav-drawing table-drawing"></view>
      <text>球桌</text>
      <view class="nav-indicator"></view>
    </view>
    <view
      class="nav-item {{tab==='services'?'nav-active':''}}"
      data-tab="services"
      bindtap="switchTab"
    >
      <view class="nav-drawing service-drawing"></view>
      <text>服务</text>
      <view class="nav-indicator"></view>
    </view>
    <view class="nav-item {{tab==='orders'?'nav-active':''}}" data-tab="orders" bindtap="switchTab">
      <view class="nav-drawing order-drawing"></view>
      <text>订单</text>
      <text wx:if="{{orderBadge}}" class="nav-count">{{orderBadge}}</text>
      <view class="nav-indicator"></view>
    </view>
    <view
      class="nav-item {{tab==='profile'?'nav-active':''}}"
      data-tab="profile"
      bindtap="switchTab"
    >
      <view class="nav-drawing profile-drawing"></view>
      <text>我的</text>
      <view class="nav-indicator"></view>
    </view>
  </view>
</view>
